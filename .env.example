# Copy to .env for local development (never commit the real file).

# Required: password for the admin area (/admin).
ADMIN_PASSWORD=change-me

# Required for AI card identification + market value research.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: where the database and uploaded photos are stored (default ./data).
# On Railway/Docker point this at a mounted volume, e.g. /data
DATA_DIR=./data

# Optional: signing key for login sessions. Generated and saved in DATA_DIR if unset.
SESSION_SECRET=

# Optional: HTTP port (default 3001).
PORT=3001
